rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // ROLES
    //   owner   — full admin (the hard-coded email below, plus anyone
    //             the owner gives the 'owner' role)
    //   arts    — arts department: manages inventory, invites creators
    //   creator — searches and views props
    //   equipment — gear team: manages gear and gear bundles (no props)
    //   admin   — (owner, Oct 20) a VIEWER: sees everything the arts department and the equipment team see,
    //             books their own shoots like a creator, invites creators and changes the booking rules.
    //             Nothing else (no inventory, queue, gear, schedule-team or settings changes; never costs).
    // A person's role lives in /users/{their email, lowercased}.
    // Keep OWNER_EMAIL in sync with src/config.ts and storage.rules.
    // ─────────────────────────────────────────────────────────────
    function ownerEmail() { return 'alexisricordi@gmail.com'; }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function profilePath() { return /databases/$(database)/documents/users/$(myEmail()); }
    function hasActiveProfile() {
      return exists(profilePath()) && get(profilePath()).data.active == true;
    }
    function role() {
      return !signedIn() ? 'none'
        : myEmail() == ownerEmail() ? 'owner'
        : hasActiveProfile() ? get(profilePath()).data.role
        : 'none';
    }
    function isOwner()  { return role() == 'owner'; }
    // isStaff / isGearStaff = people who CHANGE things; canSee / canSeeGear = also the admin (viewer).
    function isStaff()  { return role() in ['owner', 'arts']; }
    function canSee()   { return role() in ['owner', 'arts', 'admin']; }
    function isMember() { return role() in ['owner', 'arts', 'creator', 'admin']; }
    function isGearStaff() { return role() in ['owner', 'equipment']; }
    function canSeeGear()  { return role() in ['owner', 'equipment', 'admin']; }

    // ─── Users ──────────────────────────────────────────────────
    function validUser(email) {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'name', 'role', 'active', 'invitedBy', 'invitedAt', 'updatedAt', 'updatedBy', 'access',
                                'movedTo', 'movedAt', 'movedBy', 'movedFrom'])   // written by changeUserEmail (server)
        && d.get('access', 'props') in ['props', 'full']
        && d.email == email
        && email == email.lower()
        && d.role in ['owner', 'arts', 'creator', 'equipment', 'admin']
        && d.active is bool;
    }

    match /users/{email} {
      allow read: if canSee() || (signedIn() && myEmail() == email);
      // Invites (owner, Oct 20): only the owner (any role) and admins (creators only).
      // Test launch (owner, Oct 27): `access` 'props' (demo: search the props only; also when missing) or 'full'. ONLY the owner
      // changes it; an admin's invites always start on Props only.
      allow create: if validUser(email)
        && (isOwner() || (role() == 'admin' && request.resource.data.role == 'creator'
                          && request.resource.data.get('access', 'props') == 'props'));
      allow update: if validUser(email)
        && (isOwner()
            || (role() == 'admin' && resource.data.role == 'creator' && request.resource.data.role == 'creator'
                && request.resource.data.get('access', 'props') == resource.data.get('access', 'props')));
      allow delete: if false; // deactivate instead, so history stays intact
    }

    // ─── Inventory ──────────────────────────────────────────────
    function validItem() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.get('quantity', 1) is int && d.get('quantity', 1) >= 1 && d.get('quantity', 1) <= 100000
        && d.get('condition', 'good') in ['good', 'fair', 'damaged']
        && (d.get('replacementCost', 0) is number && d.get('replacementCost', 0) >= 0)
        && d.get('photos', []) is list && d.get('photos', []).size() <= 20
        && d.get('archived', false) is bool
        && d.get('collection', 'personal') in ['personal', 'company'];
    }

    // Which inventory a prop belongs to: 'company' (Prime Capitol, everyone sees it)
    // or 'personal' (the owner's own; ONLY the owner). No field = personal: every
    // prop from before this existed was the owner's.
    function isCompanyProp(d) {
      return d.get('collection', 'personal') == 'company';
    }

    match /items/{id} {
      allow read: if isOwner() || (isMember() && isCompanyProp(resource.data));
      // updatedBy must be the person making the change: the activity log relies on it.
      // Only the owner can add, change or move personal props.
      allow create: if isStaff() && validItem()
        && request.resource.data.updatedBy == request.auth.uid
        && (isOwner() || isCompanyProp(request.resource.data));
      allow update: if isStaff() && validItem()
        && request.resource.data.updatedBy == request.auth.uid
        && (isOwner() || (isCompanyProp(resource.data) && isCompanyProp(request.resource.data)));
      allow delete: if false; // archive instead
    }

    // "Suggest an edit" on a prop: anyone can suggest (in their own name, about a prop
    // they can see); the arts department applies or dismisses. Never deleted.
    match /suggestions/{id} {
      allow read: if canSee() || (isMember() && resource.data.by == myEmail());
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['itemId', 'itemName', 'by', 'byName', 'at', 'status', 'message', 'changes', 'photos'])
        && request.resource.data.by == myEmail()
        && request.resource.data.status == 'open'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1000
        && request.resource.data.get('changes', {}) is map
        && request.resource.data.get('photos', []) is list && request.resource.data.get('photos', []).size() <= 5
        && request.resource.data.itemId is string
        && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId))
        && (isOwner() || isCompanyProp(get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data));
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt', 'reply'])
        && request.resource.data.status in ['applied', 'dismissed'];
      allow delete: if false;
    }

    // Batch import (Phase 6): written only by the server, read by the arts department.
    // Imports are the owner's (owner, Oct 20).
    match /import_jobs/{id} {
      allow read: if isOwner();
    }
    match /import_items/{id} {
      allow read: if isOwner();
    }

    // Changes to the owner's personal props: owner only.
    match /activity_personal/{id} {
      allow read: if isOwner();
    }

    // Activity log: written only by the server, read by the arts department.
    match /activity/{id} {
      allow read: if canSee();
    }

    function validCategory() {
      return request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.get('turnaroundDays', 0) is int
        && request.resource.data.get('turnaroundDays', 0) >= 0
        && request.resource.data.get('turnaroundDays', 0) <= 30;
    }
    match /categories/{id} {
      allow read: if isMember();
      // Categories are maintenance: the owner only (owner, Oct 20). Their turnaround days are a booking rule,
      // which admins may also change.
      allow create: if validCategory() && isOwner();
      allow update: if validCategory()
        && (isOwner()
            || (role() == 'admin' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['turnaroundDays', 'updatedAt', 'updatedBy'])));
      allow delete: if false; // hide instead
    }

    match /tags/{id} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    match /bins/{id} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    match /locations/{id} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    // Characters are an arts-department-only field for now.
    match /characters/{id} {
      allow read: if canSee();
      allow write: if isStaff();
    }

    // Old quick checkout (removed Oct 20): kept read-only for the record.
    match /checkouts/{id} {
      allow read: if canSee();
      allow write: if false;
    }

    // Arts-department-only details for a prop (internal notes). Kept in a
    // separate document so creators can't read them even outside the app.
    match /item_private/{id} {
      allow read: if isOwner()
        || (canSee() && exists(/databases/$(database)/documents/items/$(id))
            && isCompanyProp(get(/databases/$(database)/documents/items/$(id)).data));
      allow write: if isOwner()
        || (isStaff() && exists(/databases/$(database)/documents/items/$(id))
            && isCompanyProp(get(/databases/$(database)/documents/items/$(id)).data));
    }

    // Health page bookkeeping (e.g. "not a duplicate" decisions).
    match /health/{id} {
      allow read: if canSee();
      allow write: if isStaff();
    }

    // ─── Gear (equipment team) ──────────────────────────────────
    // Every piece of gear (with replacement value): gear team only. Bundles are what
    // creators book, so members can see them. Only server functions write both,
    // which keeps "a piece is in one bundle at a time" true.
    match /gear_items/{id} {
      allow read: if canSeeGear();
      allow write: if false;
    }
    match /gear_bundles/{id} {
      allow read: if isMember() || canSeeGear();
      allow write: if false;
    }
    // Holds on each bundle/extra (times only, no names), so the app can show what's free.
    match /gear_holds/{id} {
      allow read: if isMember() || canSeeGear();
      allow write: if false;
    }
    // Gear bookings: the creator sees their own; the owner and equipment team see all.
    // House schedule: one doc per day (who booked each slot, offsite shoots, blocked time).
    // Everyone can see the schedule; only server functions write it.
    match /schedule_days/{day} {
      allow read: if isMember() || canSeeGear();
      allow write: if false;
    }
    // Shoots: the creator sees their own; the owner and schedule team (equipment) see all.
    match /shoots/{id} {
      allow read: if canSeeGear() || (isMember() && resource.data.creatorEmail == myEmail());
      allow write: if false;
    }
    // Swap requests between two creators: only those two (and the schedule team) see them; server writes.
    match /swap_requests/{id} {
      allow read: if canSeeGear() || (signedIn() && (resource.data.fromEmail == myEmail() || resource.data.toEmail == myEmail()));
      allow write: if false;
    }
    // Invites to film back to back (a held slot for a friend): the two people + the schedule team; server-only writes.
    match /schedule_invites/{id} {
      allow read: if canSeeGear() || (signedIn() && (resource.data.fromEmail == myEmail() || resource.data.toEmail == myEmail()));
      allow write: if false;
    }
    // Profiles: a small photo + channel name. Everyone in the company sees them; you edit your own;
    // the owner and schedule team can tidy anyone's (e.g. remove a photo).
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['photoURL', 'googlePhoto', 'channel', 'tourDoneAt', 'updatedAt'])
        && d.get('tourDoneAt', '') is string && d.get('tourDoneAt', '').size() <= 40
        && d.get('photoURL', '') is string && d.get('photoURL', '').size() <= 1000
        && d.get('googlePhoto', '') is string && d.get('googlePhoto', '').size() <= 1000
        && d.get('channel', '') is string && d.get('channel', '').size() <= 60;
    }
    match /profiles/{email} {
      allow read: if isMember() || canSeeGear();
      allow create, update: if validProfile() && ((signedIn() && myEmail() == email && (isMember() || canSeeGear())) || isGearStaff());
      allow delete: if false;
    }
    // Check-ins & accountability: reports about the slot before (team + the reporter), strikes and
    // pauses (the person themselves + team). Server writes only.
    match /schedule_reports/{id} {
      allow read: if canSeeGear() || (signedIn() && resource.data.byEmail == myEmail());
      allow write: if false;
    }
    match /strikes/{id} {
      allow read: if canSeeGear() || (signedIn() && resource.data.email == myEmail());
      allow write: if false;
    }
    // What an admin did about a flag (excused / warned / strike / handled). Owner + admins read; server-only writes.
    match /flag_reviews/{id} {
      allow read: if role() in ['owner', 'admin'];
      allow write: if false;
    }
    match /user_status/{email} {
      allow read: if canSeeGear() || (signedIn() && myEmail() == email);
      allow write: if false;
    }
    match /gear_bookings/{id} {
      // Shared gear (friends filming back to back): everyone on its crew can see it too.
      allow read: if canSeeGear() || (isMember() && (resource.data.creatorEmail == myEmail() || myEmail() in resource.data.get('crewEmails', [])));
      allow write: if false;
    }

    // Smart-search fingerprints. Only the server functions touch these.
    match /item_vectors/{id} {
      allow read, write: if false;
    }

    // AI usage counters (Health page) + this month's AI helper spend. Written by the server only.
    // Per-person daily counts: the owner, or that person.
    match /ai_usage/{month} {
      allow read: if isOwner();   // money: the owner only (owner, Oct 20)
      allow write: if false;
      match /people/{email} {
        allow read: if isOwner() || (signedIn() && myEmail() == email);
        allow write: if false;
      }
    }
    // Photo clean-up log (owner).
    match /cleanup_runs/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Queued and sent emails. Written only by the server; the owner can see the log.
    match /outbox/{id} {
      allow read: if isOwner();
    }

    match /app_settings/{id} {
      allow read: if isMember() || (id in ['schedule', 'calendarCheck'] && canSeeGear());
      // Booking rules: the owner and admins only (owner, Oct 20). Every other setting: the owner.
      allow write: if isOwner()
        || (role() == 'admin' && id == 'booking'
            && request.resource.data.keys().hasOnly(['leadTimeDays', 'buildLeadDays', 'bufferDays', 'maxDays', 'closedWeekdays', 'closedDates', 'updatedAt', 'updatedBy'])
            && request.resource.data.get('closedWeekdays', []) is list
            && request.resource.data.get('closedWeekdays', []).size() <= 6
            && request.resource.data.get('closedDates', []) is list
            && request.resource.data.get('closedDates', []).size() <= 200
            && request.resource.data.get('maxDays', 1) is int
            && request.resource.data.get('maxDays', 1) >= 1 && request.resource.data.get('maxDays', 1) <= 60
            && request.resource.data.leadTimeDays is int
            && request.resource.data.leadTimeDays >= 0 && request.resource.data.leadTimeDays <= 60
            && request.resource.data.bufferDays is int
            && request.resource.data.bufferDays >= 0 && request.resource.data.bufferDays <= 30);
    }

    // Reservations are created and changed only by the server functions,
    // which enforce availability. Creators see their own; staff see all.
    match /reservations/{id} {
      allow read: if canSee() || (isMember() && resource.data.creatorEmail == myEmail());
      allow write: if false;
    }

    // Which dates each prop is booked (no names), so everyone can see availability.
    match /item_bookings/{itemId} {
      allow read: if isMember();
      allow write: if false;
    }

    // Old Videos checklist data, kept as-is and readable only by the owner.
    // Anything not listed in this file is locked for everyone.
    match /video_checklists/{id} {
      allow read: if isOwner();
    }
  }
}
