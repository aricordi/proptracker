rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Roles come from the same /users collection as firestore.rules.
    // Keep the owner email in sync with firestore.rules and src/config.ts.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function profilePath() { return /databases/(default)/documents/users/$(myEmail()); }
    function isOwner() { return signedIn() && myEmail() == 'alexisricordi@gmail.com'; }
    function hasRole(roles) {
      return signedIn()
        && firestore.exists(profilePath())
        && firestore.get(profilePath()).data.active == true
        && firestore.get(profilePath()).data.role in roles;
    }
    function isMember() { return isOwner() || hasRole(['owner', 'arts', 'creator']); }
    function isStaff()  { return isOwner() || hasRole(['owner', 'arts']); }
    function isGearStaff() { return isOwner() || hasRole(['owner', 'equipment']); }

    // Gear and bundle photos: creators see bundles, the gear team uploads.
    match /gear/{allPaths=**} {
      allow read: if isMember() || isGearStaff();
      allow create, update: if isGearStaff()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Gear return photos (everything in the case, batteries charging): the creator who
    // booked it adds them; they and the gear team can see them. Add-only.
    function gearBookedBy(bookingId) {
      return firestore.get(/databases/(default)/documents/gear_bookings/$(bookingId)).data.creatorEmail == myEmail();
    }
    match /gear-returns/{bookingId}/{file} {
      allow read: if isGearStaff() || (isMember() && gearBookedBy(bookingId));
      // resource == null: only brand-new files, so a return photo can't be swapped later.
      allow create: if resource == null && (isGearStaff() || (isMember() && gearBookedBy(bookingId)))
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /items/{allPaths=**} {
      allow read: if isMember();
      allow create, update: if isStaff()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    function isImage() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    function bookedBy(resId) {
      return firestore.get(/databases/(default)/documents/reservations/$(resId)).data.creatorEmail == myEmail();
    }

    // Proof photos for a booking: what was packed, how it came back.
    match /reservation-photos/{resId}/{kind}/{file} {
      allow read: if isStaff() || (isMember() && bookedBy(resId));
      // resource == null: only brand-new files, so existing proof can't be overwritten.
      allow create: if resource == null && isImage() && (
        (kind in ['pack', 'checkin'] && isStaff())
        || (kind == 'return' && (isStaff() || (isMember() && bookedBy(resId)))));
      allow update, delete: if false;
    }

    // Reference photos creators attach to build-to-order requests.
    match /request-photos/{email}/{file} {
      allow read: if isMember();
      allow create: if resource == null && isImage() && isMember() && myEmail() == email;
      allow update, delete: if false;
    }

    // Shoot check-in photos (the set, and any mess from the slot before): the creator who booked adds
    // them; they and the schedule team can see them. Add-only.
    function shootBookedBy(shootId) {
      return firestore.get(/databases/(default)/documents/shoots/$(shootId)).data.creatorEmail == myEmail();
    }
    match /shoot-photos/{shootId}/{file} {
      allow read: if isGearStaff() || ((isMember() || isGearStaff()) && shootBookedBy(shootId));
      allow create: if resource == null && isImage() && (isGearStaff() || shootBookedBy(shootId));
      allow update, delete: if false;
    }

    // Profile photos (small, square). Everyone in the company can see them; you upload your own.
    match /avatars/{email}/{file} {
      allow read: if isMember() || isGearStaff();
      allow create: if resource == null && isImage() && (isMember() || isGearStaff()) && myEmail() == email;
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read: if isOwner();
    }
  }
}
