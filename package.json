{
  "name": "proptracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "firebase emulators:exec --only auth,functions,firestore,storage --project demo-proptracker \"vitest run\"",
    "test:watch": "vitest",
    "emulator": "npm --prefix functions run build && firebase emulators:start --project demo-proptracker",
    "seed": "node scripts/seed-emulator.mjs --reset",
    "dev:emulator": "VITE_USE_EMULATORS=true vite",
    "pretest": "npm --prefix functions run build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@types/qrcode": "^1.5.6",
    "firebase": "^10.14.0",
    "pluralize": "^8.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^14.27.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9",
    "workbox-window": "^7.1.0"
  }
}
